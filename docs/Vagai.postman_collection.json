    {
      "name": "Cadastrar conta de demonstração",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/cadastro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"{{nome}}\",\n  \"senha\": \"{{senha}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
